import { AnimatedQrCode } from "compat/widgets.slint";
import { Palette, Size } from "compat/theme.slint";

enum QrDensity {
    Low,
    Medium,
    High,
}

component DensityChoice inherits Rectangle {
    in property <QrDensity> value;
    in property <QrDensity> selected;
    callback clicked();

    width: 32px;
    height: 24px;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 9px;
        height: 9px;
        background: root.selected == root.value ? Palette.content-brand : Palette.content-tertiary;
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component LianaDynamicQrCode inherits Rectangle {
    pure callback get-parts(int) -> [string];

    private property <QrDensity> density: QrDensity.Medium;
    private property <[string]> parts: get-parts(density-int(density));

    width: 100%;
    height: 390px;

    pure function density-int(value: QrDensity) -> int {
        value == QrDensity.Low ? 250 : value == QrDensity.Medium ? 500 : 1000;
    }

    function select-density(value: QrDensity) {
        density = value;
        parts = get-parts(density-int(value));
    }

    swipe := SwipeGestureHandler {
        width: 100%;
        height: 100%;
        handle-swipe-left: true;
        handle-swipe-right: true;

        swiped => {
            if (self.current-position.x - self.pressed-position.x < -50px) {
                root.select-density(root.density == QrDensity.Low ? QrDensity.Medium : QrDensity.High);
            } else if (self.current-position.x - self.pressed-position.x > 50px) {
                root.select-density(root.density == QrDensity.High ? QrDensity.Medium : QrDensity.Low);
            }
        }

        VerticalLayout {
            alignment: start;
            spacing: Size.sz4;

            HorizontalLayout {
                alignment: center;
                AnimatedQrCode { parts: root.parts; }
            }

            HorizontalLayout {
                alignment: center;
                spacing: Size.sz1;
                for value in [QrDensity.Low, QrDensity.Medium, QrDensity.High]: DensityChoice {
                    value: value;
                    selected: root.density;
                    clicked => { root.select-density(value); }
                }
            }
        }
    }
}
