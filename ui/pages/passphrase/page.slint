import {
    AppHeader,
    BasePage,
    ButtonSection,
    ContentSection,
    IconButton,
    PageBody,
    PasswordInput,
    TextMd,
    TextSm,
} from "@ui/widgets.slint";
import { Importance, Palette, Size } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Liana } from "../../liana-theme.slint";
import { LianaButton, LianaCard } from "../../liana-widgets.slint";
import { PassphrasePageProps } from "./props.slint";

export component PassphrasePagePage inherits Rectangle {
    in property <PassphrasePageProps> props;
    property <string> passphrase;
    property <string> confirmation;
    property <bool> matches: passphrase == confirmation;

    BasePage {
        VerticalLayout {
            AppHeader {
                title: TR2.lookup(TrId.PassphraseTitle);
                side-padding: Size.sz6;
                IconButton {
                    icon: "chevron-left";
                    size: Size.sz8;
                    importance: Importance.normal;
                    clicked => { Navigate.backward(); }
                }
                Rectangle { }
            }

            PageBody {
                ContentSection {
                    spacing: Size.sz3;

                    TextMd {
                        text: TR2.lookup(TrId.PassphraseBody);
                        color: Palette.content-secondary;
                        wrap: word-wrap;
                    }

                    PasswordInput {
                        placeholder: TR2.lookup(TrId.PassphrasePlaceholder);
                        text <=> root.passphrase;
                    }

                    PasswordInput {
                        placeholder: TR2.lookup(TrId.PassphraseConfirm);
                        text <=> root.confirmation;
                        has-error: confirmation != "" && !matches;
                        message: confirmation != "" && !matches
                            ? TR2.lookup(TrId.PassphraseMismatch)
                            : "";
                    }

                    TextSm {
                        text: TR2.lookup(TrId.PassphraseTemporary);
                        color: Palette.content-tertiary;
                        wrap: word-wrap;
                    }

                    LianaCard {
                        width: 448px;
                        VerticalLayout {
                            padding: Size.sz4;
                            spacing: Size.sz1;
                            TextSm {
                                text: Callbacks.passphrase-active
                                    ? TR2.lookup(TrId.PassphraseActive)
                                    : TR2.lookup(TrId.PassphraseFingerprint);
                                color: Palette.content-tertiary;
                            }
                            TextMd {
                                text: Callbacks.wallet-fingerprint;
                                color: Liana.green;
                            }
                        }
                    }

                    if Callbacks.passphrase-error != "": TextSm {
                        text: Callbacks.passphrase-error;
                        color: Liana.recovery;
                        wrap: word-wrap;
                    }
                }

                ButtonSection {
                    LianaButton {
                        label: TR2.lookup(TrId.PassphraseApply);
                        primary: true;
                        enabled: passphrase != "" && matches;
                        clicked => {
                            Callbacks.apply-passphrase(passphrase);
                            if Callbacks.passphrase-error == "" {
                                root.passphrase = "";
                                root.confirmation = "";
                                Navigate.home-page({ });
                            }
                        }
                    }

                    if Callbacks.passphrase-active: LianaButton {
                        label: TR2.lookup(TrId.PassphraseClear);
                        primary: false;
                        clicked => {
                            Callbacks.clear-passphrase();
                            if Callbacks.passphrase-error == "" { Navigate.home-page({ }); }
                        }
                    }
                }
            }
        }
    }
}
