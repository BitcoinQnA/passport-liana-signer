import { ButtonSection, ContentSection, AppHeader, TextLg, TextMd, TextSm, BasePage,
         PageBody, IconButton, JumboIcon, Icon, BtcAddress } from "../../compat/widgets.slint";
import { Importance, Palette, Size, IconSize, FontSize } from "../../compat/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { VerifyPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Liana } from "../../liana-theme.slint";
import { LianaButton, LianaCard } from "../../liana-widgets.slint";

export component VerifyPagePage inherits Rectangle {
    in property <VerifyPageProps> props;

    BasePage {
        VerticalLayout {
            AppHeader {
                title: TR2.lookup(TrId.VerifyTitle);
                side-padding: Size.sz6;
                IconButton {
                    icon: "chevron-left";
                    size: Size.sz8;
                    importance: Importance.normal;
                    clicked => { Navigate.backward(); }
                }
                Rectangle { }
            }

            PageBody {
                p-x: Size.sz4;
                ContentSection {
                    spacing: Size.sz3;

                    HorizontalLayout {
                        alignment: center;
                        padding-top: Size.sz2;
                        JumboIcon {
                            name: "jumbo-circle";
                            // Liana-green check when verified, red warning when not.
                            Icon {
                                name: Callbacks.verify-matched ? "check" : "alert";
                                size: IconSize.px96;
                                color: Callbacks.verify-matched ? Liana.green : Liana.recovery;
                            }
                        }
                    }

                    TextLg {
                        text: Callbacks.verify-title;
                        color: Callbacks.verify-matched ? Liana.green : Liana.recovery;
                        bold: true;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    TextMd {
                        text: Callbacks.verify-detail;
                        color: Palette.content-secondary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.verify-addr != "": LianaCard {
                        width: 448px;
                        height: 128px;
                        recovery: !Callbacks.verify-matched;
                        VerticalLayout {
                            width: 444px;
                            padding-left: Size.sz1;
                            padding-right: Size.sz1;
                            padding-top: Size.sz3;
                            padding-bottom: Size.sz3;
                            spacing: Size.sz1;
                            alignment: center;
                            TextSm {
                                text: TR2.lookup(TrId.VerifyAddressLabel);
                                color: Liana.on-surface-dim;
                                horizontal-alignment: center;
                            }
                            BtcAddress {
                                address: Callbacks.verify-addr;
                                items-per-row: 8;
                                font-size: FontSize.md;
                                primary-color: Liana.on-surface;
                                secondary-color: Liana.on-surface-dim;
                                section-spacing: Size.sz0_5;
                            }
                        }
                    }

                    if Callbacks.verify-checksum != "": HorizontalLayout {
                        alignment: center;
                        spacing: Size.sz2;
                        TextSm {
                            text: TR2.lookup(TrId.VerifyPolicyChecksum);
                            color: Palette.content-tertiary;
                        }
                        TextMd {
                            text: Callbacks.verify-checksum;
                            color: Liana.green;
                            bold: true;
                        }
                    }
                }

                ButtonSection {
                    if Callbacks.verify-matched: LianaButton {
                        label: Callbacks.verify-response-required
                            ? TR2.lookup(TrId.VerifyConfirm)
                            : TR2.lookup(TrId.CommonButtonDone);
                        primary: true;
                        clicked => {
                            if Callbacks.verify-response-required {
                                Callbacks.confirm-address();
                                if Callbacks.verify-has-response {
                                    Navigate.verify-response-page({ });
                                }
                            } else {
                                Navigate.home-page({ });
                            }
                        }
                    }
                    if !Callbacks.verify-matched: LianaButton {
                        label: TR2.lookup(TrId.CommonButtonDone);
                        primary: true;
                        clicked => { Navigate.home-page({ }); }
                    }
                }
            }
        }
    }
}
