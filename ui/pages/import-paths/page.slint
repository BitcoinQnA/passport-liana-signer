import { ButtonSection, ContentSection, AppHeader, HeadingLg, TextMd, TextSm,
         BasePage, PageBody, IconButton, Icon } from "../../compat/widgets.slint";
import { Importance, Palette, Size } from "../../compat/theme.slint";
import { Callbacks, PathRow } from "../../callbacks.slint";
import { ImportPathsPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Liana } from "../../liana-theme.slint";
import { LianaButton } from "../../liana-widgets.slint";

export component ImportPathsPagePage inherits Rectangle {
    in property <ImportPathsPageProps> props;
    private property <PathRow> current-path: Callbacks.detail-paths[Callbacks.import-path-index];

    BasePage {
        VerticalLayout {
            AppHeader {
                title: TR2.lookup(TrId.ImportPathsTitle);
                side-padding: Size.sz6;
                IconButton {
                    icon: "chevron-left";
                    size: Size.sz8;
                    importance: Importance.normal;
                    clicked => {
                        if Callbacks.import-path-index > 0 {
                            Callbacks.import-path-index -= 1;
                        } else {
                            Navigate.backward();
                        }
                    }
                }
                Rectangle { }
            }

            PageBody {
                p-x: Size.sz4;
                p-y: Size.sz4;
                ContentSection {
                    spacing: Size.sz4;

                    TextSm {
                        text: TR2.format(TrId.ImportPathsProgress, [Callbacks.import-path-index + 1, Callbacks.detail-paths.length]);
                        color: Palette.content-tertiary;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            name: root.current-path.is-recovery ? "hourglass" : "check-circle";
                            size: 64px;
                            color: root.current-path.is-recovery ? Liana.recovery : Liana.green;
                        }
                    }

                    TextSm {
                        text: root.current-path.kind-label;
                        color: root.current-path.is-recovery ? Liana.recovery : Liana.green;
                        bold: true;
                        horizontal-alignment: center;
                    }
                    HeadingLg {
                        text: root.current-path.headline;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    TextMd {
                        text: root.current-path.detail;
                        color: Palette.content-secondary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                ButtonSection {
                    LianaButton {
                        label: TR2.lookup(TrId.CommonButtonContinue);
                        primary: true;
                        clicked => {
                            if Callbacks.import-path-index + 1 < Callbacks.detail-paths.length {
                                Callbacks.import-path-index += 1;
                            } else if Callbacks.detail-signers.length > 0 {
                                Callbacks.import-signer-index = 0;
                                Navigate.import-signers-page({ });
                            } else {
                                Navigate.import-confirm-page({ });
                            }
                        }
                    }
                }
            }
        }
    }
}
